# Online Restaurant — Environment Configuration
# Copy to .env and fill in real values. Never commit .env.

# Application
APP_NAME="Online Restaurant"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:8080"]

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/online_restaurant

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Trial
DEFAULT_TRIAL_DAYS=15

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# OpenAI (placeholder — leave empty until integrated)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp (placeholder)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio / Voice (placeholder)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Frontend URL (for password reset links, etc.)
FRONTEND_URL=http://localhost:5500
